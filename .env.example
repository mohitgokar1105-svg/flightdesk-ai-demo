# Copy to .env (git-ignored) and fill in locally. Never commit .env.
# Values in this project's .env take priority over variables set globally in your shell.

# Your OpenAI API key (https://platform.openai.com/api-keys). Leave empty to run without AI.
OPENAI_API_KEY=
# Model used for every AI feature. Must support structured outputs + tool calling.
OPENAI_MODEL=gpt-4.1
APP_ENV=development
# true = no AI calls at all (rule-based reader, templates, data-only answers). Set false to switch AI on.
DEMO_MODE=true

# Optional
# DATABASE_URL=sqlite:///data/flightdesk.db
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=2
# Assumed list prices (USD per 1M tokens) used only for cost *estimates*. Verify against current OpenAI pricing.
# OPENAI_PRICE_INPUT_PER_1M=2.00
# OPENAI_PRICE_OUTPUT_PER_1M=8.00

# Demo accounts created at startup if they don't exist (passwords are stored only as scrypt hashes).
# Choose your own values; never use demo passwords in production.
FLIGHTDESK_OWNER_USERNAME=
FLIGHTDESK_OWNER_PASSWORD=
FLIGHTDESK_USER_USERNAME=
FLIGHTDESK_USER_PASSWORD=
