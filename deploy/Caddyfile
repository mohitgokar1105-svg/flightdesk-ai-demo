# Automatic HTTPS (Let's Encrypt) for SITE_ADDRESS, e.g. desk.example.com. Use ":80" for plain HTTP on a private network.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Streamlit uses WebSockets; reverse_proxy handles the upgrade. Caddy appends the real client IP to X-Forwarded-For,
	# which the app reads (TRUST_PROXY_HEADERS=1) for its server-side rate limits.
	reverse_proxy app:8501
}
